# ============================================================
#  Travel Planner Agent — Environment Configuration
#  IBM Cloud Lite + IBM Granite (watsonx.ai)
# ============================================================

# ------ IBM watsonx.ai Credentials ------
# Sign up free at: https://cloud.ibm.com/registration
# Then go to: https://dataplatform.cloud.ibm.com/wx/home
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://au-syd.ml.cloud.ibm.com

# ------ IBM Granite Model ------
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# ------ Flask Application Settings ------
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=travel-agent-secret-key-change-in-production
PORT=5000

# ------ Weather API (OpenWeatherMap - Free Tier) ------
# Sign up at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ------ Optional: IBM Natural Language Understanding ------
# IBM Cloud Lite: https://cloud.ibm.com/catalog/services/natural-language-understanding
IBM_NLU_API_KEY=your_nlu_api_key_here
IBM_NLU_URL=https://api.us-south.natural-language-understanding.watson.ibm.com/instances/your_instance_id

# ------ Optional: IBM Language Translator ------
IBM_TRANSLATOR_API_KEY=your_translator_api_key_here
IBM_TRANSLATOR_URL=https://api.us-south.language-translator.watson.ibm.com/instances/your_instance_id

# ------ Application Config ------
MAX_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.9
REPETITION_PENALTY=1.1
